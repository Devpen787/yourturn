{
  "name": "booked-rights-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "rm -rf .next && next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "ethglobal:preflight": "node scripts/ethglobal-preflight.mjs",
    "ethglobal:e2e": "node scripts/ethglobal-e2e.mjs",
    "hedera:agent-check": "NODE_OPTIONS=--no-warnings node scripts/hedera-agent-check.mjs",
    "hedera:nft-delegation-proof": "NODE_OPTIONS=--no-warnings node scripts/hedera-nft-delegation-proof.mjs",
    "hedera:delegated-recovery-hak-check": "NODE_OPTIONS=--no-warnings node scripts/hedera-delegated-recovery-hak-check.mjs",
    "hedera:usdc-recovery-check": "NODE_OPTIONS=--no-warnings node --experimental-transform-types scripts/hedera-policy-usdc-recovery-check.mjs",
    "hedera:booking-policy-check": "NODE_OPTIONS=--no-warnings node --experimental-transform-types scripts/hedera-booking-right-policy-check.mjs && NODE_OPTIONS=--no-warnings node --experimental-transform-types scripts/hedera-booking-right-provider-state-check.mjs && npm run hedera:usdc-recovery-check",
    "hedera:usdc-allowance-proof": "node scripts/hedera-usdc-allowance-proof.mjs",
    "hedera:x402-settlement-proof": "node scripts/x402-hedera-settlement-proof.mjs",
    "hedera:nft-studio-proof": "node scripts/nft-studio-proof.mjs",
    "hedera:agent-lab-proof": "node scripts/agent-lab-proof.mjs",
    "hedera:week5-capture": "node scripts/capture-week5-demo-assets.mjs",
    "telegram:fixture": "node scripts/telegram-fixture-test.mjs",
    "docs:brand-appendix": "node scripts/generate-brand-ui-appendix.mjs",
    "ledger:mandate-check": "node scripts/ledger-recovery-mandate-check.mjs && node scripts/ledger-recovery-mandate-runtime-check.mjs",
    "dev:ceremony": "rm -rf .next && next dev -H 127.0.0.1 -p 3000"
  },
  "dependencies": {
    "@hashgraph/hedera-agent-kit": "^4.0.0",
    "@hashgraph/hedera-wallet-connect": "^2.1.3",
    "@hashgraph/sdk": "2.81.0",
    "@hiero-ledger/sdk": "^2.81.0",
    "@reown/appkit": "^1.8.21",
    "@reown/appkit-controllers": "^1.8.21",
    "@reown/walletkit": "^1.5.5",
    "@upstash/redis": "1.34.3",
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/universal-provider": "^2.23.9",
    "@x402/core": "^2.15.0",
    "@x402/hedera": "^2.15.0",
    "ethers": "^6.17.0",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "overrides": {
    "pino": "8.17.2",
    "nanoid": "^3.3.19",
    "js-yaml": "^4.3.2",
    "axios": "^1.20.0",
    "browserslist": "^4.28.9",
    "viem": "^2.56.3",
    "@hashgraph/hedera-agent-kit": {
      "ws": "^8.21.3"
    },
    "@walletconnect/jsonrpc-ws-connection": {
      "ws": "7.5.11"
    }
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.18",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3"
  }
}
