# --- Next.js app (Booked Rights v1 MVP) ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TREASURY_ID=
HEDERA_TREASURY_KEY=
HEDERA_FEE_COLLECTOR_ID=
HEDERA_FEE_COLLECTOR_KEY=
HEDERA_GUEST_A_ID=
HEDERA_GUEST_A_KEY=
HEDERA_GUEST_B_ID=
HEDERA_GUEST_B_KEY=
BOOKED_RIGHTS_TOKEN_ID=
BOOKED_RIGHTS_TOPIC_ID=
NEXT_PUBLIC_HASHSCAN_BASE=https://hashscan.io/#/testnet
NEXT_PUBLIC_MIRROR_BASE=https://testnet.mirrornode.hedera.com/api/v1
# Set to "true" to show Provider dashboard in the header on customer pages (/slots, /my-bookings, /resale).
# Default (unset): hidden on those routes so the nav matches a customer-only surface; home + /issuer always show it.
# NEXT_PUBLIC_SHOW_PROVIDER_NAV_ON_CUSTOMER_PAGES=true
NEXT_PUBLIC_APP_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Optional Telegram Concierge transport ---
# Dry-run fixture testing works without these values.
# Live Telegram delivery requires TELEGRAM_ALLOWED_CHAT_IDS.
# Set TELEGRAM_ALLOW_MUTATIONS=true only after dry-run testing with an allowlisted chat.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_ALLOW_MUTATIONS=false
# TELEGRAM_DEMO_ACTOR=guestA

# --- Optional OpenClaw ACP runtime descriptor/runtime ---
# YourTurn exposes honest descriptor-only OpenClaw status until a gateway is configured.
# Hedera x402 exact payment requirements are exposed at /api/x402/recovery-policy.
# Full x402 settlement requires a signed X-PAYMENT payload and facilitator verification.
# OPENCLAW_GATEWAY_URL=
# OPENCLAW_API_KEY=
# ACP_GATEWAY_URL=
# ACP_RUNTIME=

# --- Optional Hedera x402 + HTS/USDC policy budget ---
# Defaults follow Hedera x402 testnet discovery and Circle Hedera testnet USDC.
# HEDERA_X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# HEDERA_X402_FEE_PAYER_ID=0.0.7162784
# HEDERA_X402_PAY_TO_ID=
# HEDERA_X402_SETTLEMENT_ENABLED=false
# HEDERA_USDC_TOKEN_ID=0.0.429274
# YOURTURN_X402_HBAR_TINYBARS=1000000
# YOURTURN_X402_USDC_UNITS=10000
# YOURTURN_POLICY_USDC_LIMIT_UNITS=5000000
# YOURTURN_POLICY_USDC_SPENT_UNITS=0
# YOURTURN_POLICY_USDC_ALLOWANCE_TX_ID=

# --- Optional browser wallet consent via Hedera WalletConnect / Reown ---
# Required only for the in-app "Connect wallet budget" button.
# NEXT_PUBLIC_REOWN_PROJECT_ID=

# --- Email + demo app auth ---
# Production / `next start`: required, min 16 chars.
# `npm run dev`: optional — a safe local fallback is used if unset.
# AUTH_SESSION_SECRET=
# ENABLE_DEMO_LOGIN=false
# DEMO_ISSUER_EMAIL=demo-issuer@bookedrights.local
# DEMO_ISSUER_PASSWORD=BookedRights-Demo-Issuer-2026!
# DEMO_USER_A_EMAIL=demo-user-a@bookedrights.local
# DEMO_USER_A_PASSWORD=BookedRights-Demo-UserA-2026!
# DEMO_USER_B_EMAIL=demo-user-b@bookedrights.local
# DEMO_USER_B_PASSWORD=BookedRights-Demo-UserB-2026!

# --- ETHOnline Ledger Recovery Mandate signer enrollment ---
# Public EVM account addresses only; never put a private key here.
# The prepare route resolves these from the signed server-side guest persona and
# rejects client signer-address overrides. Configure the address shown by the
# Ledger Ethereum account that will later sign the identical EIP-712 mandate.
# This configuration alone is not LIVE/DEVICE proof.
# LEDGER_GUEST_A_SIGNER_ADDRESS=
# LEDGER_GUEST_B_SIGNER_ADDRESS=

# --- Optional: alternate Vite / adapter frontend (from bootstrap review) ---
# VITE_HEDERA_NETWORK=testnet
# VITE_BOOKING_TOKEN_ID=
# VITE_MIRROR_NODE_BASE_URL=https://testnet.mirrornode.hedera.com
