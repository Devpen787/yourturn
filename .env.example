# --- Next.js app (Booked Rights v1 MVP) ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# Optional: ECDSA | ED25519 | DER — required for 64-char hex ECDSA keys (SDK defaults wrongly parse them as Ed25519)
# HEDERA_OPERATOR_KEY_TYPE=
HEDERA_TREASURY_ID=
HEDERA_TREASURY_KEY=
# HEDERA_TREASURY_KEY_TYPE=
HEDERA_FEE_COLLECTOR_ID=
HEDERA_FEE_COLLECTOR_KEY=
HEDERA_GUEST_A_ID=
HEDERA_GUEST_A_KEY=
# If Guest A is ECDSA with a 64-char hex key, set: HEDERA_GUEST_A_KEY_TYPE=ECDSA
# If Guest A is Ed25519 raw 64-char hex, set: HEDERA_GUEST_A_KEY_TYPE=ED25519
HEDERA_GUEST_B_ID=
HEDERA_GUEST_B_KEY=
# HEDERA_GUEST_B_KEY_TYPE=ECDSA
BOOKED_RIGHTS_TOKEN_ID=
BOOKED_RIGHTS_TOPIC_ID=
NEXT_PUBLIC_HASHSCAN_BASE=https://hashscan.io/testnet
NEXT_PUBLIC_MIRROR_BASE=https://testnet.mirrornode.hedera.com/api/v1
NEXT_PUBLIC_APP_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Email auth (same Redis as slots/listings) — see docs/AUTH-EMAIL-REDIS.md ---
# Production / `next start`: required, min 16 chars (e.g. openssl rand -hex 32).
# `npm run dev`: optional — a built-in dev fallback is used if unset (not for deploy).
# AUTH_SESSION_SECRET=

# --- Demo app login (one-click + triple-click Sign in) — see docs/AUTH-EMAIL-REDIS.md ---
# ENABLE_DEMO_LOGIN=false
# DEMO_ISSUER_EMAIL=demo-issuer@bookedrights.local
# DEMO_ISSUER_PASSWORD=change-me
# Legacy single guest (still maps to Hedera Guest A if present in Redis)
# DEMO_GUEST_EMAIL=demo-guest@bookedrights.local
# DEMO_GUEST_PASSWORD=change-me
# Separate demo app users — each locked to one Hedera wallet (see docs/AUTH-EMAIL-REDIS.md)
# DEMO_USER_A_EMAIL=demo-user-a@bookedrights.local
# DEMO_USER_A_PASSWORD=change-me
# DEMO_USER_B_EMAIL=demo-user-b@bookedrights.local
# DEMO_USER_B_PASSWORD=change-me

# --- Optional: alternate Vite / adapter frontend (from bootstrap review) ---
# VITE_HEDERA_NETWORK=testnet
# VITE_BOOKING_TOKEN_ID=
# VITE_MIRROR_NODE_BASE_URL=https://testnet.mirrornode.hedera.com
