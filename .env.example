# --- Next.js app (Booked Rights v1 MVP) ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TREASURY_ID=
HEDERA_TREASURY_KEY=
HEDERA_FEE_COLLECTOR_ID=
HEDERA_FEE_COLLECTOR_KEY=
HEDERA_GUEST_A_ID=
HEDERA_GUEST_A_KEY=
HEDERA_GUEST_B_ID=
HEDERA_GUEST_B_KEY=
BOOKED_RIGHTS_TOKEN_ID=
BOOKED_RIGHTS_TOPIC_ID=
NEXT_PUBLIC_HASHSCAN_BASE=https://hashscan.io/testnet
NEXT_PUBLIC_MIRROR_BASE=https://testnet.mirrornode.hedera.com/api/v1
# Set to "true" to show Provider dashboard in the header on customer pages (/slots, /my-bookings, /resale).
# Default (unset): hidden on those routes so the nav matches a customer-only surface; home + /issuer always show it.
# NEXT_PUBLIC_SHOW_PROVIDER_NAV_ON_CUSTOMER_PAGES=true
NEXT_PUBLIC_APP_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Optional Telegram Concierge transport ---
# Dry-run fixture testing works without these values.
# Set TELEGRAM_ALLOW_MUTATIONS=true only with TELEGRAM_ALLOWED_CHAT_IDS configured.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_ALLOW_MUTATIONS=false
# TELEGRAM_DEMO_ACTOR=guestA

# --- Email + demo app auth ---
# Production / `next start`: required, min 16 chars.
# `npm run dev`: optional — a safe local fallback is used if unset.
# AUTH_SESSION_SECRET=
# ENABLE_DEMO_LOGIN=false
# DEMO_ISSUER_EMAIL=demo-issuer@bookedrights.local
# DEMO_ISSUER_PASSWORD=BookedRights-Demo-Issuer-2026!
# DEMO_USER_A_EMAIL=demo-user-a@bookedrights.local
# DEMO_USER_A_PASSWORD=BookedRights-Demo-UserA-2026!
# DEMO_USER_B_EMAIL=demo-user-b@bookedrights.local
# DEMO_USER_B_PASSWORD=BookedRights-Demo-UserB-2026!

# --- Optional: alternate Vite / adapter frontend (from bootstrap review) ---
# VITE_HEDERA_NETWORK=testnet
# VITE_BOOKING_TOKEN_ID=
# VITE_MIRROR_NODE_BASE_URL=https://testnet.mirrornode.hedera.com
